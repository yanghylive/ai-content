{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-content.local/docs/contracts/tool-result.schema.json",
  "title": "ToolResult",
  "description": "业务工具结果协议，对齐《整合 PRD》8.2。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "status",
    "error"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "partially_succeeded",
        "failed_retryable",
        "failed_terminal"
      ]
    },
    "data": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "uri"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "modelTokens",
        "computeUnits",
        "usageId"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "modelTokens": {
          "type": "integer",
          "minimum": 0
        },
        "computeUnits": {
          "type": "number",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "usageId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "requestId": {
              "type": "string"
            },
            "taskId": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          }
        }
      ]
    }
  }
}