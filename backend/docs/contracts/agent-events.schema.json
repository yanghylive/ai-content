{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-content.local/docs/contracts/agent-events.schema.json",
  "title": "AgentEvent",
  "description": "统一 WS 事件协议，对齐《开发前补充文档包》3.3。顶层为传输字段，逐事件必填字段在 payload。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "sequence",
    "type",
    "taskId",
    "sessionId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "message",
        "thinking",
        "tool_started",
        "tool_progress",
        "approval_required",
        "artifact_created",
        "task_paused",
        "task_failed",
        "task_done"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "message"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "content"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "thinking"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "step",
              "summary"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "toolCallId",
              "toolName"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_progress"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "toolCallId",
              "toolName",
              "progress"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval_required"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "approvalId",
              "risk",
              "preview",
              "expiresAt"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "artifact_created"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "artifactId",
              "type",
              "uri",
              "checksum"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task_paused"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "reason",
              "resumable",
              "evidence"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task_failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "reason",
              "resumable",
              "evidence"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task_done"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "reason",
              "resumable",
              "evidence"
            ]
          }
        }
      }
    }
  ]
}