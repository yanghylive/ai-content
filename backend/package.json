{
  "name": "ai-content-backend",
  "version": "0.0.1",
  "description": "Full-featured AI content creation backend for JIUZHANG AI.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node scripts/check-prisma-client-provider.mjs",
    "build": "nest build",
    "build:bundle": "prisma generate && ncc build src/main.ts -o dist-bundle --quiet",
    "build:bundle:sqlite": "node scripts/build-sqlite-bundle.mjs",
    "sync:runtime-bundle": "node scripts/sync-runtime-bundle.mjs",
    "db:generate": "prisma generate",
    "db:prepare:sqlite": "node scripts/prepare-sqlite-schema.mjs",
    "db:validate:sqlite": "npm run db:prepare:sqlite && node scripts/validate-sqlite-schema.mjs",
    "db:backup:sqlite": "node scripts/backup-sqlite.mjs",
    "db:verify-backup:sqlite": "node scripts/verify-sqlite-backup.mjs",
    "db:verify-migrations:postgres": "node scripts/verify-postgres-migrations.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:init": "npm run db:generate && npm run db:migrate",
    "db:validate": "prisma validate",
    "db:bootstrap-admin": "ts-node -r tsconfig-paths/register scripts/bootstrap-user.ts",
    "mcp:open": "playwright-cli open",
    "mcp:goto": "playwright-cli goto",
    "mcp:click": "playwright-cli click",
    "mcp:fill": "playwright-cli fill",
    "mcp:type": "playwright-cli type",
    "mcp:screenshot": "playwright-cli screenshot",
    "mcp:close": "playwright-cli close",
    "mcp:status": "playwright-cli --help",
    "setup:check": "ts-node -r tsconfig-paths/register scripts/check-first-run.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:sqlite": "node scripts/start-sqlite.mjs",
    "users:bootstrap": "ts-node -r tsconfig-paths/register scripts/bootstrap-user.ts",
    "lint": "eslint src --ignore-pattern \"**/*.spec.ts\"",
    "circular:check": "madge --circular --extensions ts --ts-config tsconfig.json src",
    "lint:fix": "eslint src --ignore-pattern \"**/*.spec.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "verify:clean-replace": "node scripts/verify-clean-replace.mjs",
    "check:no-direct-provider": "node scripts/check-no-direct-provider.mjs",
    "check:prisma-client": "node scripts/check-prisma-client-provider.mjs"
  },
  "dependencies": {
    "@effing/ffmpeg": "^0.39.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@playwright/mcp": "^0.0.75",
    "@prisma/client": "^6.19.2",
    "@types/cron": "^2.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ali-oss": "^6.23.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "juice": "^11.1.1",
    "marked": "^17.0.3",
    "nest-winston": "^1.10.2",
    "openai": "^6.25.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "playwright": "^1.60.0",
    "qiniu": "^7.15.1",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "1.3.2",
    "@img/sharp-win32-x64": "0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/cli": "^0.1.13",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
