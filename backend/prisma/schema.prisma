// CRM 导入批次：记录受控导入的 proof、写入范围、回滚令牌和回滚状态。
model CrmImportBatch {
  id                 String          @id @default(cuid())
  ownerId            String          @map("owner_id")
  tenantId           String?         @map("tenant_id")
  tenant             Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceType         String          @map("source_type")
  filename           String?
  status             String          @default("committed")
  mode               String          @default("local-crm-write")
  rowCount           Int             @default(0) @map("row_count")
  committedCount     Int             @default(0) @map("committed_count")
  skippedCount       Int             @default(0) @map("skipped_count")
  duplicateCount     Int             @default(0) @map("duplicate_count")
  warningCount       Int             @default(0) @map("warning_count")
  dryRunId           String?         @map("dry_run_id")
  dryRunProofHash    String?         @map("dry_run_proof_hash")
  commitProofHash    String          @map("commit_proof_hash")
  rollbackToken      String          @unique @map("rollback_token")
  rollbackProofHash  String?         @map("rollback_proof_hash")
  rollbackReason     String?         @map("rollback_reason") @db.Text
  mapping            Json            @default("{}")
  qualityIssues      Json            @default("[]") @map("quality_issues")
  customerIds        Json            @default("[]") @map("customer_ids")
  writeTables        Json            @default("[]") @map("write_tables")
  externalNetwork    Boolean         @default(false) @map("external_network")
  externalCrmTouched Boolean         @default(false) @map("external_crm_touched")
  committedAt        DateTime?       @map("committed_at")
  rolledBackAt       DateTime?       @map("rolled_back_at")
  metadata           Json?
  auditEvents        CrmAuditEvent[]
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([tenantId])
  @@index([sourceType])
  @@index([status])
  @@index([commitProofHash])
  @@index([dryRunId])
  @@index([committedAt])
  @@index([rolledBackAt])
  @@map("crm_import_batches")
}

// CRM 审计事件：对导入、回滚、只读建议等关键动作保留不可替代的 proof 证据。
model CrmAuditEvent {
  id                 String          @id @default(cuid())
  ownerId            String          @map("owner_id")
  tenantId           String?         @map("tenant_id")
  tenant             Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
