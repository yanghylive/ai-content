generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 后台用户表
model User {
  id                         String    @id @default(cuid())
  username                   String    @unique
  email                      String    @unique
  passwordHash               String    @map("password_hash")
  name                       String
  status                     String    @default("active") // active, disabled
  lastLoginAt                DateTime? @map("last_login_at")
  kaypalUserId               String?   @unique @map("kaypal_user_id")
  // 本地角色：operator（默认，可发起任务但不能批高风险）| manager（可批准高风险）| admin（全部权限）
  role                       String    @default("operator")
  // 商用执行开关：是否允许跳过 approval-send 走 auto-send（per-user override）
  commercialExecutionAllowed Boolean   @default(false) @map("commercial_execution_allowed")
  // 计划模式：trial（试用，有阻断）| comercial（商用，自动发送）
  planMode                   String    @default("trial") @map("plan_mode")

  sessions             UserSession[]
  ownedTenants         Tenant[]              @relation("TenantOwner")
  tenantMemberships    TenantMember[]
  redfoxConnections    RedfoxConnection[]
  redfoxSkillInstalls  RedfoxSkillInstall[]
  redfoxCallLogs       RedfoxCallLog[]
  intelligenceItems    IntelligenceItem[]
  benchmarkAccounts    BenchmarkAccount[]
  intelligenceMonitors IntelligenceMonitor[]
  intelligenceReports  IntelligenceReport[]
  complianceChecks     ComplianceCheck[]
  commentInsights      CommentInsight[]
  solutionRuns         SolutionRun[]
  brandKnowledge       BrandKnowledge[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([kaypalUserId])
  @@index([role])
  @@map("users")
}

// SaaS 租户：P1 先为每个用户创建默认组织，后续再迁移 CRM/Growth/AppMarket 到 tenantId。
model Tenant {
  id                       String                    @id @default(cuid())
  name                     String
  slug                     String                    @unique
  status                   String                    @default("active")
  ownerUserId              String                    @map("owner_user_id")
  ownerUser                User                      @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members                  TenantMember[]
  entitlements             TenantEntitlement[]
  appInstallStates         AppInstallState[]
  crmCustomers             CrmCustomer[]
  crmCompanies             CrmCompany[]
  crmOpportunities         CrmOpportunity[]
  crmTasks                 CrmTask[]
  crmNotes                 CrmNote[]
  crmTimelineEvents        CrmTimelineEvent[]
  crmImportBatches         CrmImportBatch[]
  crmAuditEvents           CrmAuditEvent[]
  growthStrategies         GrowthStrategy[]
  growthAcquisitionConfigs GrowthAcquisitionConfig[]
  growthAcquisitionRuns    GrowthAcquisitionRun[]
  growthLeads              GrowthLead[]
  growthAccountHealth      GrowthAccountHealth[]
  growthWorkflows          GrowthWorkflow[]
  growthSchedulerLeases    GrowthSchedulerLease[]
  redfoxConnections        RedfoxConnection[]
  redfoxSkillInstalls      RedfoxSkillInstall[]
  redfoxCallLogs           RedfoxCallLog[]
  intelligenceItems        IntelligenceItem[]
  benchmarkAccounts        BenchmarkAccount[]
  intelligenceMonitors     IntelligenceMonitor[]
  intelligenceReports      IntelligenceReport[]
  complianceChecks         ComplianceCheck[]
  commentInsights          CommentInsight[]
  solutionRuns             SolutionRun[]
  billingSubscriptions     BillingSubscription[]
  billingWebhookEvents     BillingWebhookEvent[]
  billingInvoices          BillingInvoice[]
  metadata                 Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@index([status])
  @@map("tenants")
}

// SaaS 租户成员：同一用户后续可加入多个组织。
model TenantMember {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("admin")
  status      String   @default("active")
  permissions Json     @default("[]")
  joinedAt    DateTime @default(now()) @map("joined_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("tenant_members")
}

// SaaS 租户授权快照：把 Kaypal 订阅、本地商业开关和后续支付回调收口成租户级事实。
model TenantEntitlement {
  id                         String    @id @default(cuid())
  tenantId                   String    @map("tenant_id")
  tenant                     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source                     String
  plan                       String    @default("FREE")
  status                     String    @default("active")
  features                   Json      @default("[]")
  commercialExecutionAllowed Boolean   @default(false) @map("commercial_execution_allowed")
  externalSubscriptionId     String?   @map("external_subscription_id")
  periodStart                DateTime? @map("period_start")
  periodEnd                  DateTime? @map("period_end")
  metadata                   Json?
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, source])
  @@index([tenantId])
  @@index([source])
  @@index([plan])
  @@index([status])
  @@index([periodEnd])
  @@map("tenant_entitlements")
}

// 计费订阅快照：由支付/Kaypal webhook 更新，作为租户级 commercial entitlement 的可审计来源。
model BillingSubscription {
  id                     String    @id @default(cuid())
  tenantId               String    @map("tenant_id")
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider               String
  externalCustomerId     String?   @map("external_customer_id")
  externalSubscriptionId String    @map("external_subscription_id")
  plan                   String    @default("FREE")
  status                 String    @default("inactive")
  currentPeriodStart     DateTime? @map("current_period_start")
  currentPeriodEnd       DateTime? @map("current_period_end")
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  latestWebhookEventId   String?   @map("latest_webhook_event_id")
  metadata               Json?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([provider, externalSubscriptionId])
  @@index([tenantId])
  @@index([provider])
  @@index([status])
  @@index([plan])
  @@index([currentPeriodEnd])
  @@map("billing_subscriptions")
}

// 计费发票审计：记录 invoice.paid / invoice.payment_failed 等事件，支撑续费、欠费和发票追溯。
model BillingInvoice {
  id                     String    @id @default(cuid())
  tenantId               String    @map("tenant_id")
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider               String
  externalInvoiceId      String    @map("external_invoice_id")
  externalCustomerId     String?   @map("external_customer_id")
  externalSubscriptionId String?   @map("external_subscription_id")
  status                 String    @default("open")
  amountDue              Int       @default(0) @map("amount_due")
  amountPaid             Int       @default(0) @map("amount_paid")
  currency               String    @default("CNY")
  hostedInvoiceUrl       String?   @map("hosted_invoice_url") @db.Text
  invoicePdfUrl          String?   @map("invoice_pdf_url") @db.Text
  attemptedAt            DateTime? @map("attempted_at")
  paidAt                 DateTime? @map("paid_at")
  failedAt               DateTime? @map("failed_at")
  latestWebhookEventId   String?   @map("latest_webhook_event_id")
  metadata               Json?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([provider, externalInvoiceId])
  @@index([tenantId])
  @@index([provider])
  @@index([status])
  @@index([externalCustomerId])
  @@index([externalSubscriptionId])
  @@index([paidAt])
  @@index([failedAt])
  @@map("billing_invoices")
}

// 计费 webhook 事件：按 provider + eventId 幂等落库，保留签名校验和处理结果。
model BillingWebhookEvent {
  id                     String    @id @default(cuid())
  provider               String
  eventId                String    @map("event_id")
  eventType              String    @map("event_type")
  tenantId               String?   @map("tenant_id")
  tenant                 Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  externalCustomerId     String?   @map("external_customer_id")
  externalSubscriptionId String?   @map("external_subscription_id")
  signatureVerified      Boolean   @default(false) @map("signature_verified")
  status                 String    @default("received")
  errorMessage           String?   @map("error_message") @db.Text
  processedAt            DateTime? @map("processed_at")
  payload                Json
  metadata               Json?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([provider, eventId])
  @@index([tenantId])
  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([externalCustomerId])
  @@index([externalSubscriptionId])
  @@index([processedAt])
  @@map("billing_webhook_events")
}

// 后台登录会话表
model UserSession {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  metadata   Json?    @map("metadata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// 内容策略表
model ContentStrategy {
  id             String  @id @default(cuid())
  name           String  @unique
  description    String? @db.Text
  industry       String  @default("通用")
  targetAudience String  @map("target_audience") @db.Text
  commercialGoal String  @map("commercial_goal") @db.Text
  corePainPoints String  @map("core_pain_points") @db.Text
  writingAngles  String  @map("writing_angles") @db.Text
  toneAndStyle   String? @map("tone_and_style") @db.Text
  isDefault      Boolean @default(false) @map("is_default")
  enabled        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isDefault])
  @@index([enabled])
  @@map("content_strategies")
}

// 素材表
model Material {
  id          String    @id @default(cuid())
  title       String
  content     String?   @db.Text
  summary     String?   @db.Text
  sourceUrl   String    @map("source_url")
  platform    String // 36Kr, Juejin, Zhihu, WeChat, Other
  author      String    @default("")
  publishDate DateTime? @map("publish_date")
  collectDate DateTime  @default(now()) @map("collect_date")
  status      String    @default("unmined") // unmined, mined, failed
  miningCount Int       @default(0) @map("mining_count") // 挖掘次数
  keywords    String[] // PostgreSQL 数组类型
  metadata    Json?

  // 图片字段（素材配图）
  imageUrl         String? @map("image_url") // 素材封面图 URL（七牛云 CDN）
  originalImageUrl String? @map("original_image_url") // 原始图片 URL
  hasImage         Boolean @default(false) // 是否有可用图片

  topics            TopicMaterial[]
  intelligenceItems IntelligenceItem[]
  complianceChecks  ComplianceCheck[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([collectDate])
  @@index([platform])
  @@index([hasImage])
  @@map("materials")
}

// 选题表
model Topic {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  summary     String?  @db.Text
  sourceType  String   @default("外部采集") @map("source_type")
  keywords    String[]

  aiScore       Float?   @map("ai_score")
  scoreDetails  Json?    @map("score_details")
  scoreReason   String?  @map("score_reason") @db.Text
  reasoning     String?  @db.Text // 商业转化分析（详细版）
  searchQueries String[] @map("search_queries") // AI 建议的搜索词组

  status      String  @default("pending") // pending, generating, completed
  isPublished Boolean @default(false) @map("is_published")

  materials         TopicMaterial[]
  articles          Article[]
  intelligenceItems IntelligenceItem[]
  complianceChecks  ComplianceCheck[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([isPublished])
  @@index([createdAt])
  @@map("topics")
}

// 选题-素材 多对多关联表
model TopicMaterial {
  topicId    String   @map("topic_id")
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([topicId, materialId])
  @@map("topic_materials")
}

// 文章表
model Article {
  id       String @id @default(cuid())
  tenantId String @default("legacy-local-desktop") @map("tenant_id")
  userId   String @default("legacy-local-user") @map("user_id")
  topicId String? @map("topic_id")
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  title           String
  content         String  @db.Text
  contentType     String  @default("article") @map("content_type") // article, xiaohongshu
  contentFormat   String  @default("markdown") @map("content_format") // markdown, html
  workspaceBrief Json? @map("workspace_brief")
  workspaceOutline Json? @map("workspace_outline")
  workspaceStep String @default("brief") @map("workspace_step")
  workspaceRevision Int @default(1) @map("workspace_revision")
  xiaohongshuData Json?   @map("xiaohongshu_data")
  wechatData      Json?   @map("wechat_data")
  rawHtml         String? @map("raw_html") @db.Text // AI 产出的原始 HTML（含图片占位符）
  finalHtml       String? @map("final_html") @db.Text // 图片替换后的最终 HTML

  templateId String? @map("template_id")
  template   Style?  @relation("ArticleTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  styleId String? @map("style_id")
  style   Style?  @relation("ArticleWritingStyle", fields: [styleId], references: [id], onDelete: SetNull)

  modelId String?  @map("model_id")
  model   AIModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  status     String  @default("draft") // draft, published
  coverImage String? @map("cover_image") // 封面图 URL

  publishRecords PublishRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([topicId])
  @@index([contentType])
  @@index([templateId])
  @@index([tenantId, userId, createdAt])
  @@map("articles")
}

// 信息源配置表
model Source {
  id                String             @id @default(cuid())
  name              String
  type              String // rss, api, crawler
  url               String
  config            Json?
  enabled           Boolean            @default(true)
  lastCrawlTime     DateTime?          @map("last_crawl_time")
  intelligenceItems IntelligenceItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("sources")
}

// RedFox 连接配置：租户级隔离，userId 保留为配置人与审计主体。
model RedfoxConnection {
  id              String          @id @default(cuid())
  tenantId        String?         @map("tenant_id")
  tenant          Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String          @default("RedFox")
  apiKeyEncrypted String          @map("api_key_encrypted") @db.Text
  apiKeyMasked    String?         @map("api_key_masked")
  status          String          @default("pending") // pending, active, failed, disabled
  dailyCallLimit  Int?            @map("daily_call_limit")
  dailyCostLimit  Int?            @map("daily_cost_limit")
  lastTestAt      DateTime?       @map("last_test_at")
  lastError       String?         @map("last_error") @db.Text
  metadata        Json?
  callLogs        RedfoxCallLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@map("redfox_connections")
}

// RedFox Skill 本地目录：由 Skill 广场同步，业务启用状态放在 RedfoxSkillInstall。
model RedfoxSkill {
  id                String               @id @default(cuid())
  skillNo           String?              @unique @map("skill_no")
  code              String               @unique
  name              String
  platform          String?
  category          String?
  tags              Json                 @default("[]")
  summary           String?              @db.Text
  description       String?              @db.Text
  inputSchema       Json?                @map("input_schema")
  outputSchema      Json?                @map("output_schema")
  status            String               @default("active")
  raw               Json?
  syncedAt          DateTime?            @map("synced_at")
  installs          RedfoxSkillInstall[]
  callLogs          RedfoxCallLog[]
  intelligenceItems IntelligenceItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([platform])
  @@index([category])
  @@index([status])
  @@index([syncedAt])
  @@map("redfox_skills")
}

// 租户启用的 RedFox Skill：绑定 KAYPAL 业务场景、限额和参数。
model RedfoxSkillInstall {
  id          String                @id @default(cuid())
  tenantId    String?               @map("tenant_id")
  tenant      Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String                @map("user_id")
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String                @map("skill_id")
  skill       RedfoxSkill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  enabled     Boolean               @default(true)
  scenario    String                @default("general")
  config      Json?
  usagePolicy Json?                 @map("usage_policy")
  lastUsedAt  DateTime?             @map("last_used_at")
  monitors    IntelligenceMonitor[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, skillId, scenario])
  @@unique([userId, skillId, scenario])
  @@index([tenantId, enabled])
  @@index([userId, enabled])
  @@index([skillId])
  @@index([scenario])
  @@map("redfox_skill_installs")
}

// RedFox 官方平台接口目录：由 /story/web/api/doc/platforms 与 platform interfaces 同步。
model RedfoxInterface {
  id           String   @id @default(cuid())
  platformCode String   @map("platform_code")
  platformName String?  @map("platform_name")
  interfaceNo  String?  @unique @map("interface_no")
  code         String   @unique
  name         String
  path         String
  method       String   @default("POST")
  scenario     String?
  status       String   @default("online")
  category     String?
  description  String?  @db.Text
  price        Float?
  minPrice     Float?   @map("min_price")
  requireAuth  Boolean  @default(true) @map("require_auth")
  parameters   Json?
  examples     Json?
  raw          Json?
  syncedAt     DateTime @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([platformCode, path, method])
  @@index([platformCode])
  @@index([path])
  @@index([scenario])
  @@index([status])
  @@index([syncedAt])
  @@map("redfox_interfaces")
}

// RedFox 调用日志：成本、延迟、失败原因和证据链入口。
model RedfoxCallLog {
  id                String             @id @default(cuid())
  tenantId          String?            @map("tenant_id")
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String             @map("user_id")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId      String?            @map("connection_id")
  connection        RedfoxConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  skillId           String?            @map("skill_id")
  skill             RedfoxSkill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)
  skillCode         String?            @map("skill_code")
  endpoint          String
  method            String             @default("POST")
  status            String             @default("pending")
  httpStatus        Int?               @map("http_status")
  costPoints        Int                @default(0) @map("cost_points")
  latencyMs         Int?               @map("latency_ms")
  retryCount        Int                @default(0) @map("retry_count")
  requestHash       String?            @map("request_hash")
  requestSummary    Json?              @map("request_summary")
  responseSummary   Json?              @map("response_summary")
  errorCode         String?            @map("error_code")
  errorMessage      String?            @map("error_message") @db.Text
  startedAt         DateTime           @default(now()) @map("started_at")
  endedAt           DateTime?          @map("ended_at")
  intelligenceItems IntelligenceItem[]
  complianceChecks  ComplianceCheck[]
  commentInsights   CommentInsight[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, startedAt])
  @@index([userId, startedAt])
  @@index([connectionId])
  @@index([skillId])
  @@index([skillCode])
  @@index([endpoint])
  @@index([status])
  @@index([requestHash])
  @@map("redfox_call_logs")
}

// 方案包运行账本：承接 RedFox 产品化方案的一次手动/定时/外部触发运行。
model SolutionRun {
  id                  String              @id @default(cuid())
  tenantId            String?             @map("tenant_id")
  tenant              Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String              @map("user_id")
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageCode         String              @map("package_code")
  packageName         String              @map("package_name")
  packageVersion      String              @default("2026-07-01") @map("package_version")
  catalogSnapshotHash String?             @map("catalog_snapshot_hash")
  trigger             String              @default("manual")
  source              String              @default("solutions")
  parentRunId         String?             @map("parent_run_id")
  correlationId       String?             @map("correlation_id")
  idempotencyKey      String?             @map("idempotency_key")
  status              String              @default("planned")
  progress            Int                 @default(0)
  startedAt           DateTime?           @map("started_at")
  endedAt             DateTime?           @map("ended_at")
  durationMs          Int?                @map("duration_ms")
  errorCode           String?             @map("error_code")
  errorMessage        String?             @map("error_message") @db.Text
  inputJson           Json                @default("{}") @map("input_json")
  resolvedPlanJson    Json                @default("{}") @map("resolved_plan_json")
  dataObjectMapping   Json                @default("{}") @map("data_object_mapping")
  riskLevel           String              @default("medium") @map("risk_level")
  confirmationPolicy  String              @default("manual_required") @map("confirmation_policy")
  sendMode            String              @default("approval-send") @map("send_mode")
  dryRun              Boolean             @default(true) @map("dry_run")
  estimatedCostPoints Int                 @default(0) @map("estimated_cost_points")
  maxCostPoints       Int                 @default(0) @map("max_cost_points")
  actualCostPoints    Int                 @default(0) @map("actual_cost_points")
