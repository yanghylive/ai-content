  @@index([runId, status])
  @@index([status])
  @@index([executorKind])
  @@index([redfoxCallLogId])
  @@index([runtimeExecutionId])
  @@index([interactionTaskId])
  @@index([agentConfirmationId])
  @@index([dedupeKey])
  @@index([requestHash])
