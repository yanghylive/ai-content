// 品牌知识库（D1）：用户上传产品/品牌资料 → AI 创作时按选题相关度召回引用
model BrandKnowledge {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  type      String   @default("brand") // brand | product | copy | manual
  tags      Json     @default("[]")
  source    String? // text | pdf | doc
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("brand_knowledge")
}

// 竞品账号订阅（A6/M5）：用户订阅竞品账号 → cron 每日抓取 → 变化检测推送
model AccountSubscription {
  id            String    @id @default(cuid())
  tenantId      String?   @map("tenant_id")
  userId        String    @map("user_id")
  platform      String    @default("douyin")
  accountId     String    @map("account_id") // secUid / 账号唯一 id
  accountName   String?   @map("account_name")
  accountUrl    String?   @map("account_url")
  active        Boolean   @default(true)
  lastFetchedAt DateTime? @map("last_fetched_at")
  lastSnapshot  Json?     @map("last_snapshot") // 上次抓取的账号快照（粉丝/作品/互动）
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([userId, platform, accountId])
  @@index([tenantId, userId])
  @@map("account_subscriptions")
}

// 用户记忆镜像表（B4/MemoryModule）：L1 原子记忆本地副本（MemoryCore 不可用时降级检索）
model UserMemory {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String   @default("episodic") // persona | episodic | instruction
  content    String   @db.Text
  priority   Int      @default(1) // 1-5，越高越重要
  scene      String? // 场景标签（创作/发布/选题等）
  usageCount Int      @default(0) @map("usage_count")
  lastUsedAt DateTime? @map("last_used_at")
  source     String   @default("chat") // chat | memory-core
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, type])
  @@index([userId, priority])
  @@unique([userId, type, content])
  @@map("user_memories")
}

// AI 对话审计（B6/P3）：每次对话会话记录
model AiChatLog {
