generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 后台用户表
model User {
  id                         String    @id @default(cuid())
  username                   String    @unique
  email                      String    @unique
  passwordHash               String    @map("password_hash")
  name                       String
  status                     String    @default("active") // active, disabled
  lastLoginAt                DateTime? @map("last_login_at")
  kaypalUserId               String?   @unique @map("kaypal_user_id")
  // 本地角色：operator（默认，可发起任务但不能批高风险）| manager（可批准高风险）| admin（全部权限）
  role                       String    @default("operator")
  // 商用执行开关：是否允许跳过 approval-send 走 auto-send（per-user override）
  commercialExecutionAllowed Boolean   @default(false) @map("commercial_execution_allowed")
  // 计划模式：trial（试用，有阻断）| comercial（商用，自动发送）
  planMode                   String    @default("trial") @map("plan_mode")

  sessions UserSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([kaypalUserId])
  @@index([role])
  @@map("users")
}

// 后台登录会话表
model UserSession {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  metadata   Json?    @map("metadata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// 内容策略表
model ContentStrategy {
  id             String  @id @default(cuid())
  name           String  @unique
  description    String? @db.Text
  industry       String  @default("通用")
  targetAudience String  @map("target_audience") @db.Text
  commercialGoal String  @map("commercial_goal") @db.Text
  corePainPoints String  @map("core_pain_points") @db.Text
  writingAngles  String  @map("writing_angles") @db.Text
  toneAndStyle   String? @map("tone_and_style") @db.Text
  isDefault      Boolean @default(false) @map("is_default")
  enabled        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isDefault])
  @@index([enabled])
  @@map("content_strategies")
}

// 素材表
model Material {
  id          String    @id @default(cuid())
  title       String
  content     String?   @db.Text
  summary     String?   @db.Text
  sourceUrl   String    @map("source_url")
  platform    String // 36Kr, Juejin, Zhihu, WeChat, Other
  author      String    @default("")
  publishDate DateTime? @map("publish_date")
  collectDate DateTime  @default(now()) @map("collect_date")
  status      String    @default("unmined") // unmined, mined, failed
  miningCount Int       @default(0) @map("mining_count") // 挖掘次数
  keywords    String[] // PostgreSQL 数组类型
  metadata    Json?

  // 图片字段（素材配图）
  imageUrl         String? @map("image_url") // 素材封面图 URL（七牛云 CDN）
  originalImageUrl String? @map("original_image_url") // 原始图片 URL
  hasImage         Boolean @default(false) // 是否有可用图片

  topics TopicMaterial[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([collectDate])
  @@index([platform])
  @@index([hasImage])
  @@map("materials")
}

// 选题表
model Topic {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  summary     String?  @db.Text
  sourceType  String   @default("外部采集") @map("source_type")
  keywords    String[]

  aiScore       Float?   @map("ai_score")
  scoreDetails  Json?    @map("score_details")
  scoreReason   String?  @map("score_reason") @db.Text
  reasoning     String?  @db.Text // 商业转化分析（详细版）
  searchQueries String[] @map("search_queries") // AI 建议的搜索词组

  status      String  @default("pending") // pending, generating, completed
  isPublished Boolean @default(false) @map("is_published")

  materials TopicMaterial[]
  articles  Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([isPublished])
  @@index([createdAt])
  @@map("topics")
}

// 选题-素材 多对多关联表
model TopicMaterial {
  topicId    String   @map("topic_id")
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([topicId, materialId])
  @@map("topic_materials")
}

// 文章表
model Article {
  id      String  @id @default(cuid())
  topicId String? @map("topic_id")
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  title           String
  content         String  @db.Text
  contentType     String  @default("article") @map("content_type") // article, xiaohongshu
  contentFormat   String  @default("markdown") @map("content_format") // markdown, html
  xiaohongshuData Json?   @map("xiaohongshu_data")
  rawHtml         String? @map("raw_html") @db.Text // AI 产出的原始 HTML（含图片占位符）
  finalHtml       String? @map("final_html") @db.Text // 图片替换后的最终 HTML

  templateId String? @map("template_id")
  template   Style?  @relation("ArticleTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  styleId String? @map("style_id")
  style   Style?  @relation("ArticleWritingStyle", fields: [styleId], references: [id], onDelete: SetNull)

  modelId String?  @map("model_id")
  model   AIModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  status     String  @default("draft") // draft, published
  coverImage String? @map("cover_image") // 封面图 URL

  publishRecords PublishRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([topicId])
  @@index([contentType])
  @@index([templateId])
  @@map("articles")
}

// 信息源配置表
model Source {
  id            String    @id @default(cuid())
  name          String
  type          String // rss, api, crawler
  url           String
  config        Json?
  enabled       Boolean   @default(true)
  lastCrawlTime DateTime? @map("last_crawl_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("sources")
}

// 风格管理表
model Style {
  id             String  @id @default(cuid())
  name           String  @unique
  description    String? @db.Text
  promptTemplate String  @map("prompt_template") @db.Text
  parameters     Json?
  isDefault      Boolean @default(false) @map("is_default")
  type           String  @default("article") // article, image, template, xiaohongshu

  articles          Article[] @relation("ArticleWritingStyle")
  templatedArticles Article[] @relation("ArticleTemplate")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@map("styles")
}

// AI 平台表
model AIPlatform {
  id      String  @id @default(cuid())
  name    String  @unique
  baseUrl String  @map("base_url")
  apiKey  String  @map("api_key")
  enabled Boolean @default(true)
  config  Json?

  models AIModel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_platforms")
}

// AI 模型配置表
model AIModel {
  id      String @id @default(cuid())
  name    String
  modelId String @map("model_id")

  platformId String     @map("platform_id")
  platform   AIPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)
  config  Json?

  articles Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([platformId, modelId])
  @@map("ai_models")
}

// 默认模型配置表
model DefaultModelConfig {
  id      String @id @default(cuid())
  purpose String @unique // article_creation, image_creation, x_collection, topic_selection
  modelId String @map("model_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("default_model_configs")
}

// 计划任务配置表
model ScheduleConfig {
  id          String    @id @default(cuid())
  taskType    String    @unique @map("task_type") // collect_materials, mine_materials, create_articles
  cronExpr    String    @map("cron_expr") // Cron 表达式
  enabled     Boolean   @default(false)
  config      Json? // 针对每个任务的额外配置 (如：单次处理数量、平台等)
  lastRunTime DateTime? @map("last_run_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schedule_configs")
}

// 系统运行日志表
model SystemLog {
  id      String @id @default(cuid())
  level   String @default("info") // info, warning, error, success
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([level])
  @@map("system_logs")
}

// 发布账号配置表
model PublishAccount {
  id       String  @id @default(cuid())
  platform String // wechat, zhihu, juejin, xiaohongshu
  name     String // 账号名称或备注
  appId    String? @map("app_id") // 对应 authorizer_appid
  apiToken String? @map("api_token") // 第三方 API 鉴权 Token 等
  config   Json? // 其他配置信息 (如 cookie/密钥)

  records PublishRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("publish_accounts")
}

// 发布记录表
model PublishRecord {
  id String @id @default(cuid())

  articleId String  @map("article_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  accountId String         @map("account_id")
  account   PublishAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  platform     String // wechat 等
  status       String  @default("pending") // pending, success, failed
  publishUrl   String? @map("publish_url") // 发布的文章外部链接或外部 ID
  errorMessage String? @map("error_message") @db.Text // 报错信息记录

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([articleId])
  @@index([accountId])
  @@index([status])
  @@map("publish_records")
}

// 系统配置表（key-value 结构，用于存储七牛云等系统级参数）
model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// === 5 个新 migration 加的 model（schema 跟代码不同步，CI 编译补齐）===

// 风险策略表（migration 20260530140948）
model RiskPolicy {
  id             String  @id @default(cuid())
  action         String  @unique
  riskLevel      String  @default("medium") @map("risk_level")
  requireConfirm Boolean @default(true) @map("require_confirm")
  autoExecute    Boolean @default(false) @map("auto_execute")
  forbidden      Boolean @default(false)
  minPlan        String? @map("min_plan")
  allowedRoles   Json    @default("[]") @map("allowed_roles")
  whitelist      Json    @default("[]")
  description    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("risk_policies")
}

// 地理桥接任务表（migration 20260530021500）
model GeoBridgeTask {
  id             String    @id @default(cuid())
  actionId       String    @unique @map("action_id")
  actionType     String    @map("action_type")
  actionTitle    String    @map("action_title")
  status         String    @default("sent_to_ai_content")
  source         String    @default("kaypal-geo")
  brandId        String?   @map("brand_id")
  brandName      String?   @map("brand_name")
  platform       String?
  brief          String?
  goal           String?
  reason         String?
  retestWindow   String?   @map("retest_window")
  returnUrl      String?   @map("return_url")
  callbackUrl    String?   @map("callback_url")
  keyword        String?
  contentPreview String?   @map("content_preview")
  resultUrl      String?   @map("result_url")
  publishedUrl   String?   @map("published_url")
  lastCallbackAt DateTime? @map("last_callback_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([platform])
  @@index([brandName])
  @@index([updatedAt])
  @@map("geo_bridge_tasks")
}

// 本地引擎交互任务表（migration 20260530033000）
// 表名 local_engine_interaction_tasks，但代码用 prisma.interactionTask
// 跳过本 model（代码用的是 migration 3 的 InteractionTask → interaction_tasks）
// 真实代码不会访问 local_engine_interaction_tasks 表

// 本地引擎回复规则表
model InteractionReplyRule {
  id              String   @id @default(cuid())
  name            String?
  industry        String?
  tone            String?
  sendMode        String?  @map("send_mode")
  keywords        Json     @default("[]")
  forbiddenWords  Json     @default("[]") @map("forbidden_words")
  highlights      Json     @default("[]")
  closingText     String?  @map("closing_text")
  ruleJson        Json     @map("rule_json")
  escalationRules Json?    @map("escalation_rules")
  enabled         Boolean  @default(true)
  updatedAt       DateTime @default(now()) @map("updated_at")

  @@map("local_engine_reply_rules")
}

// 本地引擎 Agent 会话表
model AgentSession {
  id            String    @id @default(cuid())
  source        String    @default("web")
  status        String    @default("draft")
  title         String    @default("")
  scope         String?
  targetApp     String?   @map("target_app")
  instruction   String?   @db.Text
  riskLevel     String?   @map("risk_level")
  events        Json?     @default("[]")
  confirmations Json?     @default("[]")
  evidence      Json?     @default("[]")
  sessionJson   Json      @map("session_json")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  completedAt   DateTime? @map("completed_at")

  @@index([source])
  @@index([status])
  @@index([updatedAt])
  @@map("local_engine_agent_sessions")
}

// 本地引擎 Agent 确认表
model AgentConfirmation {
  id               String    @id @default(cuid())
  sessionId        String    @map("session_id")
  action           String
  status           String
  riskLevel        String    @map("risk_level")
  target           String?
  targetLabel      String?   @map("target_label")
  content          String?
  replyText        String?   @map("reply_text")
  operator         String?
  note             String?
  confirmationJson Json      @map("confirmation_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  decidedAt        DateTime? @map("decided_at")

  @@index([sessionId])
  @@index([status])
  @@map("local_engine_agent_confirmations")
}

// 交互任务枚举（migration 20260530140948 + 20260601010300 加了 2 个值）
enum InteractionTaskType {
  DOUYIN_COMMENT_REPLY
  DOUYIN_DIRECT_MESSAGE_REPLY
  WECHAT_REPLY_DRAFT
  WECHAT_GROUP_BROADCAST
  WECHAT_MOMENTS_PUBLISH
  CUSTOMER_FOLLOW_UP
  WECHAT_CHANNEL_COMMENT_REPLY
  WECHAT_CHANNEL_DIRECT_MESSAGE_REPLY
}

enum InteractionTaskStatus {
  QUEUED
  RUNNING
  WAITING_FOR_SEND_CONFIRMATION
  COMPLETED
  FAILED
  BLOCKED
  SKIPPED
  NO_TARGET
  PAUSED
}

enum AgentSessionSource {
  web
  agent_console
  publishing
  interaction
  system
}

enum AgentSessionStatus {
  draft
  running
  waiting_for_confirmation
  completed
  failed
  cancelled
}

enum AgentConfirmationStatus {
  pending
  approved
  rejected
  expired
}

enum AgentRiskLevel {
  low
  medium
  high
}

// 交互任务表（migration 20260530140948）
model InteractionTask {
  id                         String                @id @default(cuid())
  taskType                   InteractionTaskType   @map("taskType")
  accountId                  String?               @map("accountId")
  sessionId                  String?               @map("sessionId")
  ruleId                     String?               @map("ruleId")
  sendMode                   String                @default("approval-send")
  status                     InteractionTaskStatus @default(QUEUED)
  riskLevel                  String                @default("medium") @map("riskLevel")
  stage                      String?
  currentTarget              String?               @map("currentTarget")
  draftText                  String?               @map("draftText")
  processedCount             Int                   @default(0) @map("processedCount")
  failedCount                Int                   @default(0) @map("failedCount")
  skippedCount               Int                   @default(0) @map("skippedCount")
  batchTargets               Json?                 @map("batchTargets")
  batchSummary               Json?                 @map("batchSummary")
  events                     Json                  @default("[]")
  evidence                   Json                  @default("[]")
  config                     Json?
  createdBy                  String?               @map("createdBy")
  localTaskId                String?               @map("localTaskId")
  requiresDoubleConfirmation Boolean               @default(false) @map("requiresDoubleConfirmation")
  createdAt                  DateTime              @default(now()) @map("createdAt")
  updatedAt                  DateTime              @updatedAt @map("updatedAt")

  @@index([status])
  @@index([taskType])
  @@index([accountId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("interaction_tasks")
}

// 交互任务事件表
model InteractionTaskEvent {
  id        String   @id @default(cuid())
  taskId    String   @map("taskId")
  stage     String
  level     String   @default("info")
  message   String
  payload   Json?
  createdAt DateTime @default(now()) @map("createdAt")

  @@index([taskId])
  @@index([createdAt])
  @@map("interaction_task_events")
}

// Runtime 执行记录表（P2-D3 新增）
// 用途：所有经 ExecutorRouter 路由的互动执行结果统一持久化
// 与 InteractionTask 的关系：通过 relatedId 关联
model RuntimeExecution {
  id               String   @id @default(cuid())
  relatedId        String   @map("relatedId")
  relatedType      String   @map("relatedType")
  executor         String
  platform         String
  taskType         String   @map("taskType")
  accountId        Int?     @map("accountId")
  ok               Boolean
  status           String
  reasonCode       String   @map("reasonCode")
  userMessage      String   @map("userMessage")
  technicalMessage String?  @map("technicalMessage")
  runtimeJson      Json     @map("runtimeJson")
  evidenceJson     Json     @default("[]") @map("evidenceJson")
  readbackJson     Json?    @map("readbackJson")
  agentSSessionId  String?  @map("agentSSessionId")
  engineUrl        String?  @map("engineUrl")
  createdAt        DateTime @default(now()) @map("createdAt")

  @@index([relatedId])
  @@index([accountId])
  @@index([executor])
  @@index([status])
  @@index([createdAt])
  @@map("runtime_executions")
}
