  action             String
  status             String          @default("success")
  proofHash          String?         @map("proof_hash")
  externalNetwork    Boolean         @default(false) @map("external_network")
  externalCrmTouched Boolean         @default(false) @map("external_crm_touched")
  writeTables        Json            @default("[]") @map("write_tables")
  readTables         Json            @default("[]") @map("read_tables")
  summary            String?         @db.Text
  payload            Json?
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at")

  @@index([ownerId])
  @@index([tenantId])
  @@index([importBatchId])
  @@index([eventType])
  @@index([action])
  @@index([status])
  @@index([proofHash])
  @@index([createdAt])
  @@map("crm_audit_events")
}

