{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["query", "retrieved_at", "records", "failures"],
  "properties": {
    "query": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "platform", "canonical_url", "adapter", "authority", "verification", "evidence_path"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "canonical_url": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "minLength": 1 },
          "authority": { "enum": ["primary", "secondary", "discovery"] },
          "verification": { "enum": ["direct", "corroborated", "unverified"] },
          "evidence_path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "failures": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
