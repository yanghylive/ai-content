{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["purpose", "format", "output_directory", "acceptance_criteria"],
  "properties": {
    "purpose": { "type": "string", "minLength": 1 },
    "format": { "enum": ["png", "jpg", "webp", "svg"] },
    "output_directory": { "type": "string", "minLength": 1 },
    "aspect_ratio": { "type": "string", "minLength": 1 },
    "minimum_width": { "type": "integer", "minimum": 1 },
    "language": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
