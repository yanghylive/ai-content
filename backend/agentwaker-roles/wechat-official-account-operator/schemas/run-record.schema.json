{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwaker.local/schemas/run-record.schema.json",
  "title": "AgentWaker Workdir v1 Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "run_id",
    "goal",
    "tool",
    "started_at",
    "finished_at",
    "status",
    "profile",
    "execution_contract",
    "memory",
    "inputs",
    "outputs",
    "evidence",
    "approvals",
    "commands",
    "residual_work",
    "memory_update",
    "retention"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "agent_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "goal": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "status": {
      "enum": ["active", "complete", "partial", "blocked", "failed", "cancelled"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "schema_version", "version", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^/" },
        "schema_version": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env_example", "mcp", "skills", "runtime_sources"],
      "properties": {
        "env_example": { "$ref": "#/$defs/source_file" },
        "mcp": { "$ref": "#/$defs/source_file" },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_file" }
        },
        "runtime_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["work_dir", "memory_file"],
          "properties": {
            "work_dir": { "type": "string", "minLength": 1 },
            "memory_file": { "type": "string", "minLength": 1 },
            "target_root": { "type": ["string", "null"] }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "read_at", "read_sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^/" },
        "read_at": { "type": "string", "format": "date-time" },
        "read_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "target": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "source", "kind"],
          "properties": {
            "root": { "type": "string", "pattern": "^/" },
            "source": { "type": "string", "minLength": 1 },
            "kind": { "const": "directory" }
          }
        }
      ]
    },
    "inputs": { "$ref": "#/$defs/artifacts" },
    "outputs": { "$ref": "#/$defs/artifacts" },
    "evidence": { "$ref": "#/$defs/artifacts" },
    "approvals": {
      "type": "array",
      "items": { "$ref": "#/$defs/approval" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "residual_work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "recorded_at"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "recorded_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "memory_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "proposal_file", "entries", "promoted_at"],
      "properties": {
        "status": { "enum": ["pending", "none", "promoted", "proposal-only", "conflict"] },
        "proposal_file": { "const": "memory-update-proposal.md" },
        "entries": {
          "type": "array",
          "items": { "type": "string", "pattern": "^MEM-[0-9]{8}-[0-9]{3}$" },
          "uniqueItems": true
        },
        "promoted_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "base_sha256": { "$ref": "#/$defs/sha256" },
        "written_sha256": { "$ref": "#/$defs/sha256" },
        "current_memory_sha256": { "$ref": "#/$defs/sha256" },
        "conflict_file": { "type": "string", "minLength": 1 },
        "conflict_detected_at": { "type": "string", "format": "date-time" },
        "error": { "type": "string", "minLength": 1 },
        "post_promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checked_at", "render_exit_code", "validate_exit_code"],
          "properties": {
            "status": { "enum": ["pass", "failed"] },
            "checked_at": { "type": "string", "format": "date-time" },
            "render_exit_code": { "type": "integer" },
            "validate_exit_code": { "type": "integer" },
            "rolled_back": { "type": "boolean" },
            "rollback_render_exit_code": { "type": "integer" },
            "rollback_validate_exit_code": { "type": "integer" }
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_file", "policy_sha256", "close_requirements", "retention_rules", "closed_at", "archived_at"],
      "properties": {
        "policy_file": { "type": "string", "pattern": "^/" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "close_requirements": { "$ref": "#/$defs/close_requirements" },
        "retention_rules": { "$ref": "#/$defs/retention_rules" },
        "closed_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "archived_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "recorded_at"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target", "approved_by", "approved_at", "evidence"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string", "minLength": 1 },
        "payload_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "executed_at", "exit_code"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "executed_at": { "type": "string", "format": "date-time" },
        "exit_code": { "type": "integer" },
        "cwd": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "stdout_sha256": { "$ref": "#/$defs/sha256" },
        "stderr_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "close_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_outputs", "minimum_evidence", "minimum_residual_work"],
      "properties": {
        "minimum_outputs": { "type": "integer", "minimum": 0 },
        "minimum_evidence": { "type": "integer", "minimum": 0 },
        "minimum_residual_work": { "type": "integer", "minimum": 0 },
        "maximum_residual_work": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        }
      }
    },
    "close_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "partial", "blocked", "failed", "cancelled"],
      "properties": {
        "complete": { "$ref": "#/$defs/close_requirement" },
        "partial": { "$ref": "#/$defs/close_requirement" },
        "blocked": { "$ref": "#/$defs/close_requirement" },
        "failed": { "$ref": "#/$defs/close_requirement" },
        "cancelled": { "$ref": "#/$defs/close_requirement" }
      }
    },
    "retention_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clear_terminal_tmp_after_days", "archive_terminal_runs_after_days", "delete_archives_after_days", "preserve_memory_conflicts"],
      "properties": {
        "clear_terminal_tmp_after_days": { "type": "integer", "minimum": 0 },
        "archive_terminal_runs_after_days": { "type": "integer", "minimum": 0 },
        "delete_archives_after_days": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        },
        "preserve_memory_conflicts": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
      "then": { "properties": { "finished_at": { "type": "null" } } },
      "else": { "properties": { "finished_at": { "type": "string", "format": "date-time" } } }
    }
  ]
}
