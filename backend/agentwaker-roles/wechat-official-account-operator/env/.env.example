# 微信公众号运营 Agent 环境变量示例
# 本文件汇总 agent-soul 与 wechat-official-account-operator-skills 所需的外部配置。
# 只复制你实际需要的变量到本地忽略文件或 Secret Manager。
# 切勿将真实值提交到版本控制。

# -----------------------------------------------------------------------------
# Agent 运行时存储（所有正式任务必需）
# 三项一旦设置都必须使用绝对路径；前两项必需，AGENT_TARGET_ROOT 按任务启用。
# AGENT_WORK_DIR 保存输入、原始数据、中间产物、输出和验证证据。
# AGENT_MEMORY_FILE 指向本角色现有的长期记忆权威源，任务开始前必须完整读取。
# AGENT_TARGET_ROOT 指向本次任务正式读写的目标根目录，不替代 Workdir；未设置时产物只进入当前 run 的 output/。
# -----------------------------------------------------------------------------
AGENT_WORK_DIR=/absolute/path/to/wechat-official-account-operator/workdir
AGENT_MEMORY_FILE=/absolute/path/to/wechat-official-account-operator/agent-soul/MEMORY.md
AGENT_TARGET_ROOT=/absolute/path/to/formal/target

# -----------------------------------------------------------------------------
# 微信公众号官方 API 凭据（发布类技能必需）
# 来源：agent-soul/PROFILE.yaml、agent-soul/TOOLS.md、publish-wechat-article
# -----------------------------------------------------------------------------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ACCOUNT_TYPE=                 # 订阅号/服务号/企业号等
WECHAT_ACCOUNT_CERTIFICATION=        # 认证状态
WECHAT_API_PERMISSIONS_VERIFIED=false

# 可选：直接提供托管 Access Token，避免 CLI 临时申请。
WECHAT_ACCESS_TOKEN=

# 推荐用于固定公网出口：通过受限 SSH 强制命令从云端 Token Broker 获取。
# 配置 Broker 后，本机不需要保存 WECHAT_APP_SECRET。
WECHAT_TOKEN_BROKER_SSH_HOST=
WECHAT_TOKEN_BROKER_SSH_PORT=22
WECHAT_TOKEN_BROKER_SSH_USER=wechat-token-reader
WECHAT_TOKEN_BROKER_SSH_KEY=/absolute/path/to/id_ed25519
# 可选：指定专用 known_hosts；留空时使用 OpenSSH 默认文件。
WECHAT_TOKEN_BROKER_KNOWN_HOSTS=

# 可选：仅在测试或经批准的代理场景下覆盖。
WECHAT_API_BASE=https://api.weixin.qq.com

# -----------------------------------------------------------------------------
# 高危操作本地开关
# 除命令行确认参数外，还需显式设置以下开关才允许执行对应操作。
# 除非用户明确批准，否则保持 0。
# 来源：publish-wechat-article
# -----------------------------------------------------------------------------
WECHAT_ENABLE_MASS_SEND=0
WECHAT_ENABLE_PUBLISHED_DELETE=0

# -----------------------------------------------------------------------------
# 研究与信号来源（可选）
# 来源：research-ai-signals
# -----------------------------------------------------------------------------

# 提高 GitHub REST / Search 接口限额，用于项目发现。
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# 可选：官方 X API 读取凭证。禁止抓取或自动化消费者站点。
X_BEARER_TOKEN=

# 可选：合规 Reddit OAuth 凭证。
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# 可选：编辑通知 Bot，仅用于用户自有或已获同意的频道。
TELEGRAM_BOT_TOKEN=
TELEGRAM_EDITORIAL_CHAT_ID=

# -----------------------------------------------------------------------------
# 即页（JPage）文章草稿前预览（jpage-pre-draft-preview 必需）
# 公众号文章进入微信草稿箱前，必须把同一版本的 Markdown 与 HTML 成对上传并校验。
# 默认保持私有；公开、覆盖、删除或改可见性都需要单独确认。
# -----------------------------------------------------------------------------

# 即页服务根地址。可替换为你实际调用的 JPage URL。
JPAGE_BASE=https://jpage.cn

# 推荐：JPage CLI 用户 Token。只在本地 env 或 Secret Manager 中填写真实值。
JPAGE_TOKEN=

# 微信文章草稿前预览必须默认为 private。
JPAGE_DEFAULT_VISIBILITY=private
JPAGE_DEFAULT_TAGS=wechat-official-account,pre-draft-preview
