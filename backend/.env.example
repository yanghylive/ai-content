NODE_ENV=development
PORT=3011
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_content
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGIN=http://localhost:3010,http://127.0.0.1:3010
AUTH_COOKIE_NAME=ai_content_session
AUTH_SESSION_DAYS=14

# ===== 九章案例展示中心（case-showcase）=====
# 咨询去重键 HMAC 密钥（生产必须显式配置 32+ 字节随机串；缺省回退 KAYPAL_CREDENTIAL_MASTER_KEY）
SHOWCASE_DEDUPE_SECRET=
# 案例中心公开站点源（咨询归因 sourceUrl 的绝对前缀；正式域名已定为 cases.jiuzhangai.vip）
PUBLIC_SITE_ORIGIN=https://cases.jiuzhangai.vip
# 联系方式加密主密钥（credential-envelope AES-256-GCM；生产必须 32 字节 base64/hex，未配置则拒绝启动）
KAYPAL_CREDENTIAL_MASTER_KEY=
