{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwaker.local/schemas/role-capabilities.schema.json",
  "title": "AgentWaker Role Capability Dependencies",
  "type": "object",
  "required": ["schema_version", "role", "capabilities"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "role": { "$ref": "#/$defs/id" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "required", "used_by", "permissions", "fallback"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "version": { "type": "string", "pattern": "^(?:[~^]|>=?)?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "required": { "type": "boolean" },
          "used_by": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["skill", "profile"],
              "properties": {
                "skill": { "$ref": "#/$defs/id" },
                "profile": { "$ref": "#/$defs/id" }
              },
              "additionalProperties": false
            }
          },
          "permissions": {
            "type": "object",
            "required": ["mode", "account_actions"],
            "properties": {
              "mode": { "enum": ["read-only", "local-write", "external-write"] },
              "account_actions": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "fallback": {
            "type": "object",
            "required": ["behavior", "message"],
            "properties": {
              "behavior": { "enum": ["continue", "partial", "blocked"] },
              "message": { "type": "string", "minLength": 1, "pattern": "\\S" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*|\\{\\{[a-z0-9_]+\\}\\})$" }
  }
}
