{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwaker.local/schemas/capability.schema.json",
  "title": "AgentWaker Shared Capability",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "description", "entrypoint", "profiles", "adapters", "contracts", "permissions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/text" },
    "version": { "$ref": "#/$defs/version" },
    "description": { "$ref": "#/$defs/text" },
    "entrypoint": { "$ref": "#/$defs/path" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "description": { "$ref": "#/$defs/text" }
        },
        "additionalProperties": false
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "required"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "required": { "type": "boolean" },
          "description": { "$ref": "#/$defs/text" }
        },
        "additionalProperties": false
      }
    },
    "contracts": {
      "type": "object",
      "required": ["input_schema", "output_schema"],
      "properties": {
        "input_schema": { "$ref": "#/$defs/path" },
        "output_schema": { "$ref": "#/$defs/path" }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "properties": {
        "environment": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
        "mcp": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["default_mode", "supports_account_actions"],
      "properties": {
        "default_mode": { "enum": ["read-only", "local-write", "external-write"] },
        "supports_account_actions": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}
