{
  "name": "ai-content-frontend",
  "version": "0.1.0",
  "description": "Full-featured AI content creation dashboard for JIUZHANG AI.",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks 2>/dev/null || true",
    "dev": "next dev --webpack",
    "build": "next build && node scripts/postbuild-remove-demo.mjs && node scripts/sync-runtime-out.mjs",
    "sync:runtime-out": "node scripts/sync-runtime-out.mjs",
    "start": "next start",
    "lint": "eslint src",
    "lint:strict": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:check": "node ../scripts/demo-guard.mjs",
    "demo:guard": "node ../scripts/ci/demo-guard-ci.mjs",
    "agent-cockpit:guard": "node scripts/agent-cockpit-route-guard.mjs",
    "local-engine:guard": "node scripts/local-engine-run-check-guard.mjs",
    "navigation:zero-loss": "node scripts/navigation-zero-loss-guard.mjs",
    "navigation:zero-loss:test": "node --test scripts/navigation-zero-loss-guard.test.mjs",
    "content-workspace:guard": "node scripts/content-workspace-guard.mjs",
    "content-workspace:guard:test": "node --experimental-transform-types --test scripts/content-workspace-*.test.mjs",
    "frontend-truth:test": "node --test scripts/frontend-truth-deeplink-guard.test.mjs",
    "voice-runtime:test": "node --test scripts/voice-runtime-state-guard.test.mjs",
    "commercial-copy:guard": "node scripts/commercial-copy-guard.mjs",
    "commercial-copy:browser": "node scripts/commercial-copy-browser-scan.mjs",
    "commercial-copy:all": "npm run commercial-copy:guard && npm run commercial-copy:browser -- --require-full",
    "console-quality:browser": "node scripts/console-quality-browser-scan.mjs",
    "ui:gate": "node scripts/ui-gate.mjs",
    "ui:gate:changed": "node scripts/ui-gate.mjs --changed"
  },
  "dependencies": {
    "@heroui/react": "^2.8.9",
    "@heroui/theme": "^2.4.26",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@stylexjs/stylex": "0.19.0",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.24",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
