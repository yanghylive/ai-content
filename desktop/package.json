{
  "name": "ai-content-desktop",
  "version": "1.0.0",
  "homepage": "https://kaypal.oss-cn-hangzhou.aliyuncs.com/updates/",
  "description": "AI内容创作桌面应用 - 自动回复抖音、视频号评论和私信",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development AUTO_UPLOAD_DIR=${AUTO_UPLOAD_DIR:-/Users/yanghy/auto-upload} electron .",
    "check:commercial-assets": "node scripts/check-commercial-assets.js",
    "build": "npm run check:commercial-assets && electron-builder",
    "build:mac": "npm run check:commercial-assets && electron-builder --mac",
    "build:win": "npm run check:commercial-assets && electron-builder --win",
    "build:linux": "npm run check:commercial-assets && electron-builder --linux",
    "release": "node scripts/release.js",
    "upload:oss": "node scripts/upload-to-oss.js",
    "release:check": "node scripts/check-update-feed.js"
  },
  "keywords": [
    "ai",
    "content",
    "automation",
    "douyin",
    "wechat"
  ],
  "author": "AI Content Team",
  "license": "MIT",
  "devDependencies": {
    "ali-oss": "^6.23.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-store": "^8.2.0",
    "fix-path": "^3.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.aicontent.desktop",
    "productName": "KaypalAI内容创作平台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "cloud-api.js",
      "auto-updater.js",
      "installer/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/out",
        "to": "frontend",
        "filter": [
          "**/*.html",
          "**/*.css",
          "**/*.js",
          "**/*.json",
          "**/*.svg",
          "**/*.png",
          "**/*.ico",
          "**/*.woff2",
          "**/*.webmanifest",
          "**/*.txt",
          "_next/**",
          "!**/dev/**",
          "!**/.next/**",
          "!**/cache/**",
          "!**/server/**",
          "!**/*.map"
        ]
      },
      {
        "from": "../../../../auto-upload",
        "to": "auto-upload",
        "filter": [
          "main.py",
          "**/main.py",
          "requirements.txt",
          "**/requirements.txt",
          "conf.py",
          "**/conf.py",
          "conf.example.py",
          "**/conf.example.py",
          "cdp_runtime.py",
          "**/cdp_runtime.py",
          "platform_douyin_cdp.py",
          "**/platform_douyin_cdp.py",
          "platform_channel_cdp.py",
          "**/platform_channel_cdp.py",
          "uploader/__init__.py",
          "uploader/baijiahao_uploader/__init__.py",
          "uploader/baijiahao_uploader/main.py",
          "uploader/douyin_uploader/__init__.py",
          "uploader/douyin_uploader/cancelAllFollow.py",
          "uploader/douyin_uploader/main.py",
          "uploader/ks_uploader/__init__.py",
          "uploader/ks_uploader/main.py",
          "uploader/tencent_uploader/__init__.py",
          "uploader/tencent_uploader/main.py",
          "uploader/xhs_uploader/__init__.py",
          "uploader/xhs_uploader/main.py",
          "uploader/xhs_uploader/xhs_login_qrcode.py",
          "uploader/xiaohongshu_uploader/__init__.py",
          "uploader/xiaohongshu_uploader/main.py",
          "myUtils/__init__.py",
          "myUtils/auth.py",
          "myUtils/avatar.py",
          "myUtils/login.py",
          "myUtils/postVideo.py",
          "packaging/README-zh-CN.txt",
          "packaging/new-user-guide.html",
          "utils/__init__.py",
          "utils/base_social_media.py",
          "utils/constant.py",
          "utils/files_times.py",
          "utils/log.py",
          "utils/network.py",
          "utils/publish_limits.py",
          "utils/stealth.min.js"
        ]
      },
      {
        "from": "../backend/dist-bundle",
        "to": "backend",
        "filter": [
          "index.js",
          "schema.prisma"
        ]
      },
      {
        "from": "../backend/node_modules/.prisma/client",
        "to": "backend/client",
        "filter": [
          "*.node",
          "*.wasm",
          "*.js"
        ]
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma",
        "filter": [
          "schema.prisma",
          "migrations/**/*",
          "dev.db"
        ]
      },
      {
        "from": "backend.env",
        "to": "backend/.env"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KaypalAI内容创作平台",
      "uninstallDisplayName": "卸载 KaypalAI内容创作平台",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "installer.nsh"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "generic",
      "url": ""
    }
  }
}
