{
  "name": "ai-content-desktop",
  "version": "1.1.116",
  "homepage": "https://kaypal.oss-cn-hangzhou.aliyuncs.com/updates/",
  "author": "AI Content Team",
  "description": "AI内容创作桌面应用 - 自动回复抖音、视频号评论和私信",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "check:commercial-assets": "node scripts/check-commercial-assets.js",
    "check:full-installer-assets:pre": "node scripts/check-full-installer-assets.js --phase=pre",
    "check:full-installer-assets:post": "node scripts/check-full-installer-assets.js --phase=post",
    "check:release-size": "node scripts/check-release-size.js",
    "smoke:packaged-backend": "node scripts/smoke-packaged-backend.js",
    "smoke:credential-key": "electron scripts/smoke-electron-credential-key.js",
    "clean:mac-package-output": "node scripts/clean-mac-package-output.js",
    "prepare:playwright-browsers": "node scripts/prepare-playwright-browsers.js",
    "prepare:node-runtime": "node scripts/prepare-node-runtime.js",
    "prepare:release-config": "node scripts/prepare-release-config.js",
    "build": "npm run regenerate-icons && npm run prepare:node-runtime && npm run prepare:playwright-browsers && npm run check:commercial-assets && electron-builder",
    "build:mac": "npm run clean:mac-package-output && npm run regenerate-icons && npm run prepare:node-runtime && npm run prepare:playwright-browsers && npm run check:commercial-assets && npm run prepare:release-config && BUILD_PLATFORM=mac-arm64 npm run check:full-installer-assets:pre && electron-builder --mac && BUILD_PLATFORM=mac-arm64 npm run check:full-installer-assets:post && BUILD_PLATFORM=mac-arm64 npm run check:release-size",
    "build:win": "node scripts/build-win-full.js",
    "release": "node scripts/release.js",
    "upload:oss": "node scripts/upload-to-oss.js",
    "upload:ssh-updates": "bash scripts/upload-to-ssh-updates.sh",
    "release:check": "node scripts/check-update-feed.js",
    "test:credential-key-store": "node --test test/credential-key-store.test.cjs",
    "test:local-bridge": "node --test test/local-bridge.test.cjs",
    "test:release-feed-plan": "node --test scripts/release-feed-plan.test.js scripts/verify-oss-release.test.js scripts/extra-resources.test.js",
    "test:local-bridge:e2e": "node scripts/electron-local-bridge-e2e.mjs",
    "release:verify": "node scripts/verify-oss-release.js",
    "release:verify:remote": "node scripts/verify-oss-release.js --remote-only",
    "check:package-contents": "node scripts/check-package-contents.js",
    "regenerate-icons": "python3 scripts/regenerate-icons.py"
  },
  "keywords": [
    "ai",
    "content",
    "automation",
    "douyin",
    "wechat"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "ali-oss": "^6.23.0",
    "electron": "^44.2.0",
    "electron-builder": "^25.0.0",
    "spdx-license-list": "^6.11.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "fix-path": "^3.0.0"
  },
  "build": {
    "appId": "com.aicontent.desktop",
    "productName": "JIUZHANG AI 内容创作平台",
    "afterPack": "scripts/sign-mac-app.js",
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "sqlite-empty-template.js",
      "main.js",
      "preload.js",
      "local-bridge.js",
      "credential-key-store.js",
      "cloud-api.js",
      "auto-updater.js",
      "workspace-tabs.js",
      "tab-strip.html",
      "tab-strip-preload.js",
      "user-data-path.js",
      "browser-panel-manager.js",
      "browser-panel-ipc.js",
      "browser-panel-mode-registry.js",
      "browser-panel-broker.js",
      "browser-panel-bridge-registry.js",
      "browser-panel-bridge-runtime.js",
      "browser-broker-wiring.js",
      "browser-agent-bridge-server.js",
      "browser-control-strip.html",
      "browser-control-strip-preload.js",
      "browser-panel-gutter.html",
      "browser-approval-overlay.html",
      "browser-approval-overlay-preload.js",
      "hover-ball.html",
      "preload-hoverball.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "installer",
        "to": "installer",
        "filter": [
          "bootstrap-installer.ps1",
          "detect-deps.ps1",
          "self-check.ps1",
          "uninstall.ps1",
          "deps-manifest.json"
        ]
      },
      {
        "from": "../frontend/out",
        "to": "frontend",
        "filter": [
          "**/*.html",
          "**/*.css",
          "**/*.js",
          "**/*.json",
          "**/*.svg",
          "**/*.png",
          "**/*.webp",
          "**/*.ico",
          "**/*.woff2",
          "**/*.webmanifest",
          "**/*.txt",
          "_next/**",
          "!**/dev/**",
          "!**/.next/**",
          "!**/cache/**",
          "!**/server/**",
          "!**/*.map"
        ]
      },
      {
        "from": "../backend/dist-bundle-sqlite",
        "to": "backend",
        "filter": [
          "*.js",
          "package.json",
          "schema.prisma",
          "schema.sqlite.prisma",
          "libquery_engine*.node",
          "query_engine-windows.dll.node",
          "prompts/**/*"
        ]
      },
      {
        "from": "../vendor/skillhub",
        "to": "wechat-macos/skillhub",
        "filter": [
          "wechat-*/**/*"
        ]
      },
      {
        "from": "runtime/wechat-macos",
        "to": "wechat-macos",
        "filter": [
          "bin/**/*"
        ]
      },
      {
        "from": "runtime/wechat-engine",
        "to": "wechat-engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/wechat-native-runners",
        "to": "wechat-native-runners",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/wechat-native-runtime",
        "to": "wechat-native-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/remote-assets",
        "to": "remote-assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/agentwaker-roles",
        "to": "backend/agentwaker-roles",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/playwright-browsers",
        "to": "playwright-browsers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/octop",
        "to": "octop",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/node",
        "to": "runtime/node",
        "filter": [
          "bin/node",
          "bin/node.exe",
          "LICENSE",
          "README.md"
        ]
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma",
        "filter": [
          "schema.prisma",
          "schema.sqlite.prisma",
          "migrations/**/*",
          "seed.db"
        ]
      },
      {
        "from": "runtime/generated/backend.env",
        "to": "backend/.env"
      },
      {
        "from": "../vendor/open-cowork-upstream",
        "to": "open-cowork-upstream",
        "filter": [
          "scripts/**/*"
        ]
      },
      {
        "from": "runtime/media-tools",
        "to": "media-tools",
        "filter": [
          "bin/**/*",
          "licenses/**/*",
          "manifest.json",
          "SOURCE-OFFER.txt"
        ]
      },
      {
        "from": "runtime/generated",
        "to": "generated"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "@playwright/**/*",
          "playwright/**/*",
          "playwright-core/**/*",
          "sharp/**/*",
          "@img/**/*",
          "detect-libc/**/*",
          "semver/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "extraResources": [
        {
          "from": "../backend/node_modules/.prisma/client",
          "to": "backend/client",
          "filter": [
            "libquery_engine-darwin-arm64.dylib.node",
            "*.wasm",
            "*.js"
          ]
        }
      ],
      "target": [
        {
          "target": "zip"
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "extraResources": [
        {
          "from": "runtime/wechat-ocr",
          "to": "wechat-ocr",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "../backend/node_modules/.prisma/client",
          "to": "backend/client",
          "filter": [
            "query_engine-windows.dll.node",
            "*.wasm",
            "*.js"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JIUZHANG AI 内容创作平台",
      "uninstallDisplayName": "卸载 JIUZHANG AI 内容创作平台",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "installer.nsh"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "https://kaypal.oss-cn-hangzhou.aliyuncs.com/updates/"
    }
  }
}
