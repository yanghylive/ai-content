{
  "appId": "com.aicontent.desktop",
  "productName": "JIUZHANG AI 内容创作平台",
  "version": "1.1.115",
  "type": "multi",
  "electron": {
    "main": "main.js"
  },
  "frontend": {
    "type": "next-export",
    "dir": "../frontend/out"
  },
  "backend": {
    "type": "bundle",
    "entry": "../backend/dist-bundle-sqlite/index.js"
  },
  "sidecars": [],
  "externalDependencies": [
    "octop"
  ],
  "build": {
    "commands": [
      "npm run check:commercial-assets"
    ],
    "output": "dist"
  },
  "verify": {
    "requiredFiles": [
      "main.js",
      "assets/icon.icns",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "forbiddenPaths": [
      "agent-s-executor",
      "installer/wheelhouse"
    ],
    "maxSizeMB": 1800,
    "_maxSizeMB_note": "2026-09-01（审计 #19）：与 scripts/check-release-size.js 的 DEFAULT_APP_LIMIT_MB=1800 / DEFAULT_ARCHIVE_LIMIT_MB=700 对齐（原 500 与实际检查不符）。app 含内置 chromium/media-tools/wechat-ocr，~1351MB 属正常。"
  }
}
