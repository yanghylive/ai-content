# 自动更新 feed 地址（用户运行时检测更新）
# 留空 = 不启用自动更新
# 格式: https://<bucket>.<region>.aliyuncs.com/<updatePath>/
# 例: https://kaypalai-updates.oss-cn-hangzhou.aliyuncs.com/updates/
AI_CONTENT_UPDATE_URL=https://kaypalai-updates.oss-cn-hangzhou.aliyuncs.com/updates/

# 阿里云 OSS — 仅发布时需要（开发本机不用配）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=kaypalai-updates
OSS_REGION=oss-cn-hangzhou
OSS_UPDATE_PATH=updates/

# 可选：自定义 endpoint（金融云/专有云）
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# 发布通道（latest 给用户，beta 给内部测试）
RELEASE_CHANNEL=latest

# 要打包哪些平台（逗号分隔）
RELEASE_TARGETS=mac,win,linux

# 设为 false 跳过上传只构建（调试用）
RELEASE_PUBLISH=true
