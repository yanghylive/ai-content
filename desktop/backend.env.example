NODE_ENV=production
PORT=3011
DATABASE_URL=file:./kaypal-ai.sqlite
KAYPAL_DESKTOP_DATABASE_MODE=sqlite
SQLITE_DATABASE_URL=file:./kaypal-ai.sqlite
KAYPAL_AUTH_BASE_URL=https://kaypal.cn
CORS_ORIGIN=http://localhost:3010,http://127.0.0.1:3010
AUTH_COOKIE_NAME=ai_content_session
AUTH_SESSION_DAYS=14
AUTH_COOKIE_SECURE=false
AGENT_S_BASE_URL=http://127.0.0.1:17777
# KAYPAL_RUNTIME_SHARED_SECRET / KAYPAL_AGENT_S_TOKEN 由主进程 ensureAgentSToken() 首启随机生成并注入，禁止在此硬编码/填写已知占位值
KAYPAL_NODE_AGENT_RUNTIME=1
KAYPAL_AI_PROXY_BASE_URL=https://kaypal.cn/api/ai
KAYPAL_AI_PROXY_API_KEY=<YOUR_KAYPAL_AI_PROXY_API_KEY>
PUBLIC_ORIGIN=http://localhost:3010
MEMORY_CORE_BASE_URL=http://127.0.0.1:8420
MEMORY_CORE_USER_KEY=<YOUR_MEMORY_CORE_USER_KEY>

# ===== 商业执行 / 本地引擎开关（默认关闭真实执行，需显式授权才开）=====
LOCAL_ENGINE_PLAN_MODE=plan
LOCAL_ENGINE_COMMERCIAL_EXECUTION_ENABLED=false
AI_CONTENT_COMMERCIAL_EXECUTION_ENABLED=false
AUTO_START_KAYPAL_RUNTIME=false

# ===== 增长执行 / 调度 daemon =====
GROWTH_EXECUTION_ENABLED=false
GROWTH_SCHEDULER_DAEMON=false
GROWTH_SCHEDULER_REAL_DAEMON_ALLOWED=false
GROWTH_SCHEDULER_LEASE_MS=300000

# ===== AI 模型同步（AI 助手模型表初始化）=====
KAYPAL_API_KEY=<YOUR_KAYPAL_API_KEY>
KAYPAL_MODEL_SYNC_DEFAULT_MODEL=deepseek-v4-flash

# ===== 平台统一计费主体（系统级 AI 调用，如 MemoryCore 走 LLM 代理）=====
# 填一个绑定了 kaypal 云的账号的 kaypal_user_id，该账号需保持登录态
KAYPAL_BILLING_USER_ID=<YOUR_KAYPAL_BILLING_USER_ID>

# ===== 微信联系人视觉（联系人同步）=====
AI_CONTENT_WECHAT_CONTACT_VISION_FALLBACK=true
AI_CONTENT_WECHAT_CONTACT_VISION_MAX_BYTES=7340032

# ===== RedFox 情报数据源（趋势雷达 / 去水印 / 爆款拆解 / 情报）=====
REDFOX_API_BASE_URL=https://redfox.hk
REDFOX_API_KEY=<YOUR_REDFOX_API_KEY>
REDFOX_TIMEOUT_MS=60000
REDFOX_DAILY_USER_LIMIT=0
REDFOX_DAILY_TENANT_LIMIT=0
REDFOX_HIGH_COST_CONFIRM_THRESHOLD=0

# ===== 好单库（比价）=====
HAODANKU_APIKEY=<YOUR_HAODANKU_APIKEY>

# ===== 聚推客联盟（生活服务 CPS：外卖/出行/餐饮/到店/娱乐/充值）=====
JUTUIKE_APIKEY=<YOUR_JUTUIKE_APIKEY>
JUTUIKE_PUB_ID=<YOUR_JUTUIKE_PUB_ID>
JUTUIKE_SID=<YOUR_JUTUIKE_SID>
